# Copy to .env and fill in. The .env file is gitignored — never commit real keys.

# Required for real (non-demo) LLM runs. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-3.1-flash-lite).
# JOB_AGENT_MODEL=gemini-3.1-flash-lite
